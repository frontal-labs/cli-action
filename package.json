{
  "name": "@frontal-labs/cli-action",
  "version": "1.0.0",
  "description": "GitHub Action to setup the Frontal CLI",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build -o dist src/main.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontal-labs/cli-action.git"
  },
  "keywords": [
    "github-actions",
    "frontal",
    "cli",
    "action"
  ],
  "author": "Frontal Labs",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "^1.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.12.7",
    "@vercel/ncc": "^0.38.1",
    "typescript": "^5.4.5"
  }
}
